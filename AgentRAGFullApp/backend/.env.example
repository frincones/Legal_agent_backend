# Required
DATABASE_URL=postgresql://user:password@host:5432/database
OPENAI_API_KEY=sk-your-openai-api-key

# Optional
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ENV=development

# Config override (optional)
# RAG_CONFIG_PATH=./config/default.yaml

# Legal Sources (optional)
# Scrape.do proxy token for scraping government sites with anti-bot protection
SCRAPE_DO_TOKEN=your-scrape-do-api-token

# Sprint M18 · Brave Search API para SmartSearchTool (URL discovery generalizable)
# Get key at: https://brave.com/search/api/
# Tier requerido: cualquier plan que soporte rate >= 1 req/sec
# Endpoint: https://api.search.brave.com/res/v1/web/search
# Header: X-Subscription-Token: <key>
BRAVE_SEARCH_API_KEY=BSA...your-brave-key
